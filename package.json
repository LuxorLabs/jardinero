{
  "name": "jardinero",
  "version": "0.8.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@11.23.0",
  "type": "module",
  "scripts": {
    "build": "pnpm run build:server && pnpm run build:web",
    "build:server": "pnpm run clean:dist && tsc -p tsconfig.build.json",
    "build:test": "pnpm run clean:dist && tsc -p tsconfig.json",
    "build:web": "vite build",
    "clean:dist": "node -e \"const fs=require('node:fs');for(const d of ['dist/src','dist/test','dist/scripts'])fs.rmSync(d,{recursive:true,force:true})\"",
    "dev": "tsx src/index.ts",
    "dev:web": "vite",
    "codex:refresh": "tsx scripts/refresh-codex-auth.ts",
    "discord:register": "tsx scripts/discord-register.ts",
    "smoke:tenki": "tsx scripts/tenki-smoke.ts",
    "ui:preview": "tsx scripts/ui-preview.ts",
    "start": "node dist/src/index.js",
    "type-check": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "lint": "biome lint --error-on-warnings .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "changeset": "changeset",
    "test": "pnpm run build:test && node --test --test-timeout=120000 \"dist/src/**/*.test.js\" \"dist/test/**/*.test.js\""
  },
  "dependencies": {
    "@tenkicloud/sandbox": "1.0.2",
    "dotenv": "17.4.2",
    "freestyle": "0.2.2",
    "prom-client": "15.1.3",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@changesets/changelog-github": "1.0.0",
    "@changesets/cli": "3.0.0",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-slot": "1.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "25.9.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "peerDependenciesMeta": {}
}
