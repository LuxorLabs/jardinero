# Production image for the Jardinero HTTP orchestrator. Stage 1 compiles the
# server and dashboard; stage 2 ships the runtime plus prod dependencies.
#
# Must match `packageManager` in package.json.
ARG PNPM_VERSION=12.15.0

# The Node image is pinned by version and digest so builds are reproducible
# across devs and CI. Both stages use the same one; keep its version in step
# with .nvmrc and Dockerfile.dev.
FROM node:24.22.3-bookworm-slim@sha256:dc26ae92c9fb15cf6b1d63e20f0944b2efe0f115b20e00be48fb23fceb061c54 AS builder
ARG PNPM_VERSION
WORKDIR /app
RUN npm i -g pnpm@${PNPM_VERSION}
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm ci
COPY . .
RUN pnpm run build

FROM node:24.22.3-bookworm-slim@sha256:dc26ae92c9fb15cf6b1d63e20f0944b2efe0f115b20e00be48fb23fceb061c54 AS runtime
ARG PNPM_VERSION
ENV NODE_ENV=production
# App version surfaced by the server as the dashboard KPI; passed by CI/Makefile.
ARG BUILD_VERSION=""
ENV JARDINERO_BUILD_VERSION=$BUILD_VERSION
WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
# `pnpm ci` takes no --prod.
RUN npm i -g pnpm@${PNPM_VERSION} \
  && pnpm install --frozen-lockfile --prod \
  && rm -rf "$(pnpm store path)" \
  && npm rm -g pnpm && npm cache clean --force

COPY --from=builder /app/dist ./dist
COPY db ./db
# config/local.yaml is baked in for self-contained/ephemeral runs; real
# deployments mount their authoritative config and set CONFIG_PATH to override.
COPY config ./config

# storage.data_dir defaults to ./data; that resolves to /app/data, where the
# cluster mounts a PersistentVolume. chown so the non-root node user can write it.
RUN mkdir -p /app/data && chown -R node:node /app
USER node

EXPOSE 3000 9090
CMD ["node", "dist/src/index.js"]
