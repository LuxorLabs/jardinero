# Host-side build metadata for a Node/TypeScript repository.
# IMAGE_NAME is the registry artifact name, published as <workspace-slug>/<IMAGE_NAME>:<tag>.
# REPO_SLUG is the GitHub repository the canary clones to prove the image builds it.
IMAGE_NAME=node-repo-example
REPO_SLUG=your-org/your-node-repo
SANDBOX_CPU=4
SANDBOX_MEMORY_MB=8192
SANDBOX_DISK_GB=30
