# Copy to .env for local development. Do not commit real values.
#
# The app loads ENV_FILE when set, otherwise .env. Existing process
# environment variables win over values in this file.

# Optional path to a config file outside the repo; unset, config/local.yaml is used.
# CONFIG_PATH=/etc/jardinero/config.yaml

# Terminal log verbosity: debug | info | warn | error | silent (default: info).
# Use debug to also see HTTP health probes, per-run timing, and raw codex.* events.
# LOG_LEVEL=info
# Set NO_COLOR (or LOG_NO_COLOR) to disable ANSI colors, e.g. when piping to a file.
# NO_COLOR=1

# HTTP admin/Capsule API bearer token. Required only for persistent HTTP mode.
ORCHESTRATOR_ADMIN_TOKEN=replace-with-random-token

# Tenki preview URL exposure is enabled by default in orchestrator sandboxes.
# Set false to disable automatic public exposure of the configured server port.
# DASHBOARD_EXPOSE_ON_STARTUP=false
# DASHBOARD_EXPOSE_SLUG=jardinero-dashboard
# DASHBOARD_EXPOSE_TTL_MINUTES=240

# GitHub App credentials. Jardinero mints an installation token from these at
# runtime, so there is no personal access token to provision. See docs/secrets.md.
JARDINERO_AGENT_APP_ID=
JARDINERO_AGENT_INSTALL_ID=
JARDINERO_AGENT_PRIVATE_KEY=

# Secret GitHub signs webhook deliveries with; verified by the /webhooks/github receiver.
JARDINERO_AGENT_WEBHOOK_SECRET=replace_me

# Discord application the bot belongs to. Required when discord.enabled is true;
# the roles, channels and people it works with live in the config, not here.
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=

# Guild `pnpm run discord:register` publishes the commands to, when --guild is not passed.
DISCORD_GUILD_ID=

# Linear agent OAuth app. The client credentials are exchanged at runtime for the
# app-actor token (client_credentials grant); the webhook secret verifies Linear
# webhook deliveries.
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_WEBHOOK_SECRET=

# Tenki API key. Leave blank only when the SDK/Capsule runtime supplies ambient
# auth to the sandbox process.
TENKI_API_KEY=

# Required when the Tenki auth can access more than one project.
TENKI_PROJECT_ID=

# Optional Tenki API base URL override.
# TENKI_API_URL=https://api.tenki.cloud

# Codex auth fallback. Not needed when config/local.yaml uses:
# worker.codex_auth_mode: "capsule"
CODEX_ACCESS_TOKEN=
OPENAI_API_KEY=

# Grafana MCP service account token. Required for log_review when
# mcp.grafana.auth is "service_account"; the orchestrator forwards it to worker
# Codex profiles as the bearer token env var.
GRAFANA_SA_TOKEN=

# Grafana MCP OAuth credentials. Optional fallback when mcp.grafana.auth is
# "oauth"; the orchestrator writes these into worker Codex profiles.
GRAFANA_CLIENT_ID=
GRAFANA_ACCESS_TOKEN=
GRAFANA_REFRESH_TOKEN=
