# Development image with hot reload. Source is bind-mounted by docker-compose, so
# this stage only installs deps; `pnpm run dev` reloads on change. The Node image
# is pinned by version and digest; keep the version in step with Dockerfile.prod
# and .nvmrc.
# Must match `packageManager` in package.json.
ARG PNPM_VERSION=12.17.0

FROM node:24.22.3-bookworm-slim@sha256:dc26ae92c9fb15cf6b1d63e20f0944b2efe0f115b20e00be48fb23fceb061c54
ARG PNPM_VERSION
ENV NODE_ENV=development
WORKDIR /app
RUN npm i -g pnpm@${PNPM_VERSION}

# Dependencies are cached on their own layer; source arrives via the bind mount.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm ci

EXPOSE 3000 9090
CMD ["pnpm", "run", "dev"]
