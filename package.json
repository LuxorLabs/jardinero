{
  "name": "jardinero",
  "version": "0.12.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@12.20.0",
  "type": "module",
  "scripts": {
    "build": "pnpm run build:server && pnpm run build:web",
    "build:server": "pnpm run clean:dist && tsc -p tsconfig.build.json",
    "build:test": "pnpm run clean:dist && tsc -p tsconfig.json",
    "build:web": "vite build",
    "clean:dist": "node -e \"const fs=require('node:fs');for(const d of ['dist/src','dist/test','dist/scripts'])fs.rmSync(d,{recursive:true,force:true})\"",
    "dev": "tsx src/index.ts",
    "dev:web": "vite",
    "codex:refresh": "tsx scripts/refresh-codex-auth.ts",
    "discord:register": "tsx scripts/discord-register.ts",
    "smoke:daytona": "tsx scripts/daytona-smoke.ts",
    "smoke:freestyle": "tsx scripts/freestyle-smoke.ts",
    "smoke:tenki": "tsx scripts/tenki-smoke.ts",
    "ui:preview": "tsx scripts/ui-preview.ts",
    "start": "node dist/src/index.js",
    "type-check": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "lint": "biome lint --error-on-warnings .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "changeset": "changeset",
    "test": "pnpm run build:test && node --test --test-timeout=120000 \"dist/src/**/*.test.js\" \"dist/test/**/*.test.js\""
  },
  "dependencies": {
    "@daytona/sdk": "0.227.0",
    "@tenkicloud/sandbox": "1.4.1",
    "freestyle": "0.2.23",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "25.9.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "lucide-react": "1.72.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "peerDependenciesMeta": {}
}
